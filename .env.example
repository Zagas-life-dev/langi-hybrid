# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase web app (public values: the Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key used by App Check
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
# Optional: fixed App Check debug token for localhost (register it in the console)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Firebase Admin (server): the service-account key for Firestore + sign-in sessions ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the downloaded JSON on ONE line, or base64 of it. SECRET: .env.local and hosting env only, never git.
FIREBASE_SERVICE_ACCOUNT=

# --- App ---
# Comma-separated emails allowed to use admin-only features
LANGI_ADMIN_EMAILS=
# Shared secret for the scheduled reminders endpoint
CRON_SECRET=

# --- Video search (YouTube Data API) ---
YOUTUBE_API_KEY=

# --- Web Push reminders ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com


# Yoruba/Igbo/Hausa read-aloud clips (uploaded by scripts/generate-ng-audio.mjs). Unset = device voice.
NEXT_PUBLIC_NG_AUDIO_BASE_URL=https://res.cloudinary.com/your-cloud/video/upload/ng-audio
