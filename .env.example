# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase (Langi Hybrid: AI Logic + App Check) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=langi-hybrid
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key used by App Check
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
# Optional: fixed App Check debug token for localhost (register it in the console)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Firebase Admin (server): the service-account key from Firebase console > Project settings > Service accounts.
# Paste the downloaded JSON on ONE line, or base64 of it. SECRET: .env.local and hosting env only, never git.
FIREBASE_SERVICE_ACCOUNT=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/langi-hybrid
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LANGI_ADMIN_EMAILS=
CRON_SECRET=

# --- Legacy server AI (removed in the hackathon build) ---
AI_CHAT_BACKENDS=mistral,gemini
MISTRAL_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# --- Media / misc ---
YOUTUBE_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CLOUDINARY_URL=
NEXT_PUBLIC_STT_MODEL_BASE=
